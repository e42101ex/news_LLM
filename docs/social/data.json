 "bsky_posts": [
  {
   "text": "Surprised more people aren’t alarmed about the financial condition of Oracle. \n\nRevenue flat for 15 years adjusted for inflation, only real growth engine is unprofitable AI data centers, future entirely tied to OpenAI and the most ambitious infra projects in history. It’s dying!",
   "handle": "edzitron.com",
   "display_name": "Ed Zitron",
   "likes": 1360,
   "reposts": 208,
   "replies": 55,
   "created_at": "2026-10-03T02:47:24.799Z",
