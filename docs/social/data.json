   "created_at": "2026-07-31T15:39:45.878Z",
   "url": "https://bsky.app/profile/karlbode.com/post/3mrxbzs372c2q",
   "image": "",
   "external": "https://www.nytimes.com/2026/07/30/technology/anthropic-ai-hack.html?unlocked_article_code=1.11A.8rGG.hdtj3nVifRs6&smid=nytcore-android-share",
   "query": "Anthropic"
  },
  {
   "text": "good stuff man",
