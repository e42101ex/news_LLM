   "url": "https://bsky.app/profile/rebeccasolnit.bsky.social/post/3mxhdb6mxuk27",
   "image": "",
   "external": "",
   "query": "Anthropic"
  },
  {
   "text": "Wikimedia Foundation: \"AI companies are not doing enough to secure their systems and protect the public from the harm they cause. That burden is falling onto everyone else, including smaller organizations.\"\n\nwikimediafoundation.org/news/2026/10...",
   "handle": "evacide.bsky.social",
   "display_name": "evacide",
