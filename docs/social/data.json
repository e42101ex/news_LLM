   "reposts": 141,
   "replies": 49,
   "created_at": "2026-07-31T00:15:23Z",
   "url": "https://bsky.app/profile/bloomberg.com/post/3mrvoevjong24",
   "image": "",
   "external": "https://bloom.bg/3U3JbZC",
   "query": "OpenAI"
  },
  {
   "text": "Anthropic winning as usual",
   "handle": "timkellogg.me",
   "display_name": "mr. TIM",
   "likes": 399,
   "reposts": 52,
   "replies": 13,
   "created_at": "2026-07-31T03:01:01.717Z",
