 "bsky_posts": [
  {
   "text": "Anthropic banning “abusive or cruel behavior” toward Claude in its new usage policies is proof to me that tech companies are going to moderate violence against AI before they ever moderate violence against women and minorities",
   "handle": "kattenbarge.bsky.social",
   "display_name": "Kat Tenbarge",
   "likes": 11865,
   "reposts": 2965,
   "replies": 193,
   "created_at": "2026-10-08T19:56:05.196Z",
   "url": "https://bsky.app/profile/kattenbarge.bsky.social/post/3mxfajnqm6s2o",
   "image": "",
   "external": "",
   "query": "Anthropic"
  },
  {
   "text": "Sam Altman said people are just gonna have to die in order to implement AI. In the very same week, Anthropic claimed it’s a human rights violation to be mean to the computer. These people need to be held accountable. They think lines of code are a person with rights but living people are debris.",
   "handle": "bencollins.bsky.social",
   "display_name": "Ben Collins",
   "likes": 5923,
   "reposts": 1642,
   "replies": 165,
   "created_at": "2026-10-09T13:43:27.757Z",
   "url": "https://bsky.app/profile/bencollins.bsky.social/post/3mxh46bieqc24",
   "image": "",
   "external": "",
   "query": "Anthropic"
  },
  {
   "text": "A product no one asked for, that no one wants, that doesn't do what it claims, that burns money",
   "handle": "trance.bsky.social",
   "display_name": "Emma Evans",
   "likes": 650,
   "reposts": 227,
   "replies": 51,
   "created_at": "2026-10-09T19:48:23.012Z",
   "url": "https://bsky.app/profile/trance.bsky.social/post/3mxhqksgjp225",
