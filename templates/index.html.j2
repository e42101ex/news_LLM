<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ site_title }} · {{ meta.date }}</title>
<meta name="description" content="{{ meta.date }} AI 新聞彙整：{{ meta.topic_count }} 個主題、{{ meta.article_count }} 篇報導，同主題不同來源已整合。">
<style>
:root{
  --bg:#faf9f7; --card:#ffffff; --ink:#1c1b19; --muted:#6b6862; --line:#e6e2db;
  --accent:#b4532a; --accent-soft:#f4e8e2; --badge:#efece6;
  --shadow:0 1px 2px rgba(28,27,25,.05), 0 8px 24px -16px rgba(28,27,25,.18);
}
@media (prefers-color-scheme:dark){
  :root{
    --bg:#16150f; --card:#1f1e18; --ink:#efece4; --muted:#a09b90; --line:#302e26;
    --accent:#e8875a; --accent-soft:#2c231d; --badge:#2a2822;
    --shadow:0 1px 2px rgba(0,0,0,.3), 0 8px 24px -16px rgba(0,0,0,.6);
  }
}
*{box-sizing:border-box}
body{
  margin:0; background:var(--bg); color:var(--ink); line-height:1.65;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans TC","PingFang TC","Microsoft JhengHei",sans-serif;
  -webkit-font-smoothing:antialiased;
}
a{color:inherit}
.wrap{max-width:820px; margin:0 auto; padding:32px 20px 72px}
header{border-bottom:2px solid var(--ink); padding-bottom:18px; margin-bottom:8px}
h1{font-size:clamp(1.6rem,4.5vw,2.3rem); margin:0 0 6px; letter-spacing:-.02em}
h1 a{text-decoration:none}
.meta{color:var(--muted); font-size:.85rem; display:flex; flex-wrap:wrap; gap:6px 14px}
.cat{
  margin:44px 0 16px; font-size:.8rem; font-weight:700; letter-spacing:.12em;
  color:var(--accent); text-transform:uppercase; display:flex; align-items:center; gap:12px;
}
.cat::after{content:""; flex:1; height:1px; background:var(--line)}
/* 限定在 .details 內：否則 padding 會誤套到 <article class="brief"> 上，
   讓 brief 的縮圖撐不滿卡片寬度 */
.details article{
  background:var(--card); border:1px solid var(--line); border-radius:12px;
  padding:20px 22px; margin-bottom:14px; box-shadow:var(--shadow);
}
.details article.hot{border-left:3px solid var(--accent)}
.head{display:flex; gap:16px; align-items:flex-start}
.head .body{flex:1; min-width:0}
.thumb{
  flex:0 0 132px; width:132px; margin-top:2px;
  border-radius:8px; overflow:hidden; background:var(--badge);
}
.thumb img{display:block; width:100%; height:auto; aspect-ratio:3/2; object-fit:cover}
h3{font-size:1.12rem; margin:0 0 10px; line-height:1.45; letter-spacing:-.01em}
.summary{margin:0 0 14px; color:var(--ink)}
.row{display:flex; flex-wrap:wrap; gap:6px; align-items:center; margin-bottom:10px}
.badge{
  font-size:.72rem; padding:2px 9px; border-radius:99px; background:var(--badge);
  color:var(--muted); white-space:nowrap;
}
.badge.pri{background:var(--accent-soft); color:var(--accent); font-weight:600}
.links{list-style:none; margin:0; padding:0; border-top:1px dashed var(--line); padding-top:12px}
.links li{display:flex; gap:10px; align-items:baseline; padding:3px 0; font-size:.88rem}
.links .src{
  flex:0 0 auto; min-width:104px; color:var(--accent); font-weight:600; font-size:.78rem;
}
.links a{text-decoration:none; border-bottom:1px solid transparent}
.links a:hover{border-bottom-color:var(--accent)}
.links time{flex:0 0 auto; margin-left:auto; color:var(--muted); font-size:.75rem; font-variant-numeric:tabular-nums}
footer{margin-top:56px; padding-top:20px; border-top:1px solid var(--line); color:var(--muted); font-size:.8rem}
footer .srcs{margin-top:8px; line-height:1.9}
.empty{background:var(--card); border:1px dashed var(--line); border-radius:12px; padding:40px; text-align:center; color:var(--muted)}
/* ── 分類選單（吸頂） ── */
.tabs{
  position:sticky; top:0; z-index:20; margin:0 -20px 4px; padding:10px 20px;
  background:var(--bg);
  background:color-mix(in srgb, var(--bg) 92%, transparent);
  backdrop-filter:blur(8px); border-bottom:1px solid var(--line);
  display:flex; flex-wrap:wrap; gap:6px; scrollbar-width:none;
}
.tabs::-webkit-scrollbar{display:none}
.tabs a{
  flex:0 0 auto; text-decoration:none; font-size:.85rem; font-weight:600;
  padding:6px 13px; border-radius:99px; color:var(--muted);
  border:1px solid var(--line); background:var(--card); white-space:nowrap;
  transition:color .15s, border-color .15s;
}
.tabs a:hover{color:var(--accent); border-color:var(--accent)}
.tabs a b{font-weight:600; opacity:.55; margin-left:4px; font-size:.78rem}

/* ── 分類 brief ── */
.briefs{
  display:grid; gap:16px; margin:22px 0 12px;
  grid-template-columns:repeat(auto-fill, minmax(210px, 1fr));
  /* 突破 .wrap 的 820px，讓 brief 有 4-5 欄；下方文章維持窄版好閱讀 */
  position:relative; left:50%; transform:translateX(-50%);
  width:min(1180px, calc(100vw - 40px));
}
.brief{
  background:var(--card); border:1px solid var(--line); border-radius:12px;
  overflow:hidden; box-shadow:var(--shadow); display:flex; flex-direction:column;
}
/* 比例放在 <img> 上而不是容器上：容器有 aspect-ratio 時，flex 版面會先決定高度
   再用比例反推寬度，導致圖片撐不滿卡片。讓 img 自己撐出高度最穩。 */
.brief-hero{display:block; position:relative; background:var(--badge); overflow:hidden}
.brief-hero img{display:block; width:100%; height:auto; aspect-ratio:16/9; object-fit:cover}
.brief-hero.broken{aspect-ratio:auto; background:none}   /* 圖掛掉時只留分類標籤 */
.brief-hero.broken .brief-tag{position:static; display:inline-block}
.brief-tag{
  position:absolute; left:0; top:0; padding:4px 10px; font-size:.72rem; font-weight:700;
  color:#fff; background:var(--accent); letter-spacing:.03em;
}
.brief-tag.plain{position:static; align-self:flex-start; margin-bottom:8px}  /* flex 子項要用 align-self 才不會被拉滿 */
.brief-body{padding:12px 14px 14px; display:flex; flex-direction:column; flex:1}
.brief-lead{
  margin:0 0 10px; font-size:.97rem; line-height:1.42; font-weight:700; letter-spacing:-.01em;
  display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden;
}
.brief-lead a{text-decoration:none}
.brief-lead a:hover{color:var(--accent)}
.brief-list{list-style:none; margin:0; padding:0; border-top:1px solid var(--line)}
.brief-list li{padding:8px 0; border-bottom:1px solid var(--line); font-size:.85rem; line-height:1.45}
.brief-list a{
  display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;
}
.brief-list li:last-child{border-bottom:0}
.brief-list a{text-decoration:none; color:var(--muted)}
.brief-list a:hover{color:var(--accent)}
.brief-more{
  margin-top:auto; padding-top:10px; font-size:.78rem; color:var(--accent);
  text-decoration:none; font-weight:600;
}
.brief{padding:0; margin:0}
.details{margin-top:40px; padding-top:8px; border-top:2px solid var(--ink)}
.details-label{font-size:.8rem; font-weight:700; letter-spacing:.12em; color:var(--muted); margin:14px 0 0}
h2.cat{scroll-margin-top:66px}
article{scroll-margin-top:66px}

@media (max-width:520px){
  .briefs{grid-template-columns:repeat(auto-fill, minmax(150px, 1fr)); gap:12px;
          width:calc(100vw - 32px)}
  .brief-lead{font-size:.9rem}
  .head{gap:12px}
  .thumb{flex-basis:96px; width:96px}
  .links li{flex-wrap:wrap}
  .links .src{min-width:0}
  .links time{margin-left:0}
}
</style>
</head>
<body>
<div class="wrap">
<header>
  <h1><a href="{% if is_archive %}../{% endif %}index.html">{{ site_title }}</a></h1>
  <div class="meta">
    <span>{{ meta.date }}</span>
    <span>{{ meta.topic_count }} 個主題 · {{ meta.article_count }} 篇報導</span>
    <span>收錄近 {{ meta.window_hours }} 小時</span>
    <span>更新於 {{ meta.generated_at | localtime(tz) }}</span>
    <a href="{% if is_archive %}index.html{% else %}archive/index.html{% endif %}">歷史存檔</a>
  </div>
</header>

{% if not groups %}
<div class="empty">這個時間範圍內沒有抓到符合條件的 AI 新聞。</div>
{% endif %}

{% if groups %}
<nav class="tabs" aria-label="主題分類">
  {% for category, topics in groups %}
  <a href="#cat{{ loop.index0 }}">{{ category }}<b>{{ topics | length }}</b></a>
  {% endfor %}
</nav>

<section class="briefs">
  {% for category, topics in groups %}
  {% set lead = topics[0] %}
  <article class="brief">
    {% if lead.image %}
    <a class="brief-hero" href="#{{ lead.key }}">
      <img src="{{ '' if lead.image.startswith('http') else img_prefix }}{{ lead.image }}"
           alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer"
           onerror="this.parentNode.classList.add('broken'); this.remove()">
      <span class="brief-tag">{{ category }}</span>
    </a>
    {% endif %}
    <div class="brief-body">
      {% if not lead.image %}<span class="brief-tag plain">{{ category }}</span>{% endif %}
      <h3 class="brief-lead"><a href="#{{ lead.key }}">{{ lead.title }}</a></h3>
      {% if topics | length > 1 %}
      <ul class="brief-list">
        {% for t in topics[1:4] %}
        <li><a href="#{{ t.key }}">{{ t.title }}</a></li>
        {% endfor %}
      </ul>
      {% endif %}
      <a class="brief-more" href="#cat{{ loop.index0 }}">看這個分類的 {{ topics | length }} 則 →</a>
    </div>
  </article>
  {% endfor %}
</section>

<div class="details">
<p class="details-label">全部主題</p>
{% endif %}

{% for category, topics in groups %}
<h2 class="cat" id="cat{{ loop.index0 }}">{{ category }}</h2>
{% for t in topics %}
<article id="{{ t.key }}"{% if t.importance >= 4 or t.sources | length >= 3 %} class="hot"{% endif %}>
  <div class="head">
    <div class="body">
      <div class="row">
        {% if t.importance >= 4 %}<span class="badge pri">重點</span>{% endif %}
        {% if t.sources | length > 1 %}<span class="badge">{{ t.sources | length }} 家媒體報導</span>{% endif %}
        {% for kw in t.keywords[:3] %}<span class="badge">{{ kw }}</span>{% endfor %}
      </div>
      <h3>{{ t.title }}</h3>
      {% if t.summary %}<p class="summary">{{ t.summary }}</p>{% endif %}
    </div>
    {% if t.image %}
    <div class="thumb">
      <img src="{{ '' if t.image.startswith('http') else img_prefix }}{{ t.image }}"
           alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer"
           onerror="this.parentNode.remove()">
    </div>
    {% endif %}
  </div>
  <ul class="links">
    {% for a in t.articles %}
    <li>
      <span class="src">{{ a.source }}</span>
      <a href="{{ a.url }}" target="_blank" rel="noopener noreferrer">{{ a.title }}</a>
      <time datetime="{{ a.published }}">{{ a.published | localtime(tz) }}</time>
    </li>
    {% endfor %}
  </ul>
</article>
{% endfor %}
{% endfor %}
{% if groups %}</div>{% endif %}

<footer>
  <div>由 <code>auto_report_news</code> 自動產生 · 分群為機器判定，摘要僅供快速瀏覽，細節請點原文。</div>
  <div class="srcs">來源：{{ sources | join(" · ") }}</div>
</footer>
</div>
</body>
</html>
